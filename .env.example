# Obtain these at https://my.telegram.org/apps. Do not use a Bot API token.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_your_api_hash

# Comma-separated channels/groups already joined by the logged-in account.
# Use signed IDs from `python -m app.cli chats`, or public @usernames.
TELEGRAM_CHATS=-1001234567890,@my_video_channel

# This must be reachable by your Stremio player. Use the host's LAN IP for TV/mobile.
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=data
ADDON_NAME=Telegram Movies

# Optional shared secret path: /<token>/manifest.json and /<token>/video/...
# Leave empty for localhost testing. Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADDON_TOKEN=

# Match exact title/year via Cinemeta. Explicit caption IMDb IDs work even if false.
METADATA_LOOKUP=true

# Initial scan: latest 1000 messages per chat, not 1000 videos. 0 scans all history.
HISTORY_LIMIT=1000
SYNC_INTERVAL=300
MAX_STREAMS=4
TELEGRAM_TIMEOUT=30
